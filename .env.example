# anthropic (live Claude), selfhosted, replay (recorded John Doe answers, no key needed) or mock
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Used when LLM_PROVIDER=selfhosted (any OpenAI-compatible chat endpoint, e.g. vLLM)
LLM_SERVER_URL=
LLM_MODEL=
# Postgres connection string, or pglite:./.pglite for embedded Postgres with no install (pglite:memory is throwaway)
DATABASE_URL=postgres://localhost:5432/petition_prep
DEMO_MODE=true
PORT=3000
