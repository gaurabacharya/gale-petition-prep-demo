{
  "name": "petition-prep",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "migrate": "tsx src/db/migrate-cli.ts",
    "start": "tsx src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build:pages": "vite build --config web/vite.pages.config.ts && cp web/dist-pages/index.html web/dist-pages/404.html",
    "preview:pages": "vite preview --config web/vite.pages.config.ts",
    "samples": "tsx scripts/make-samples.ts",
    "demo:reset": "tsx src/db/reset-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@electric-sql/pglite": "^0.5.10",
    "@hono/node-server": "^2.1.5",
    "@tesseract.js-data/eng": "^1.0.0",
    "clsx": "^2.1.1",
    "effect": "^3.22.3",
    "hono": "^4.13.13",
    "lucide-react": "^1.59.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "unpdf": "^1.7.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^21.0.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  }
}
